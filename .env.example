# ==============================================================================
# Academic Risk Radar — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services locally or in Docker.
# NEVER commit a real production JWT_SECRET to version control.

# API Server Configuration
PORT=4000
NODE_ENV=development

# Database & Queue Connections (Local default: localhost; Docker default: mongodb / redis)
MONGO_URI=mongodb://127.0.0.1:27017/academic_risk_radar
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cryptographic JSON Web Token Secret
JWT_SECRET=evaluation_development_jwt_secret_radar_2026_change_in_production

# Frontend Next.js Configuration
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
